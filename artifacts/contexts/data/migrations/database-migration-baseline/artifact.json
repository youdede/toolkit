{
  "$schema": "../../../../../schema/artifact.schema.json",
  "schemaVersion": 1,
  "id": "context/data/migrations/database-migration-baseline",
  "slug": "database-migration-baseline",
  "name": "Database Migration Baseline",
  "version": "1.0.0",
  "kind": "context",
  "summary": "Apply a provenance-backed database migration baseline to the repository files where that decision surface is active.",
  "description": "A generated scoped context whose ordered rules are copied from catalog summaries and remain traceable to their source artifacts without hand-maintained policy prose.",
  "domain": "data",
  "category": "migrations",
  "capabilities": [
    "operate",
    "verify"
  ],
  "problems": [
    "migration-safety",
    "schema-compatibility-control"
  ],
  "frameworks": [
    "agnostic"
  ],
  "languages": [
    "agnostic"
  ],
  "lifecycle": [
    "planning",
    "implementation",
    "review"
  ],
  "risk": "low",
  "license": "MIT",
  "authors": [
    "Youdede"
  ],
  "refuses": [
    "It does not override narrower repository-local policy or explicit human approval requirements.",
    "It does not turn advisory guidance into permission to mutate external systems or protected state.",
    "It does not remain silently authoritative after its declared expiry date."
  ],
  "execution": {
    "mode": "prompt",
    "entrypoints": []
  },
  "context": {
    "scope": "glob",
    "globs": [
      "**/migrations/**",
      "**/*.sql"
    ],
    "precedence": 400,
    "expires": "2027-09-21",
    "provenance": [
      "skill/data/migrations/review-database-migration-plan",
      "skill/data/schemas/review-schema-evolution",
      "hook/data/migrations/migration-safety-guard"
    ],
    "rules": [
      {
        "id": "01-review-migration-plan",
        "effect": "require",
        "action": "review-migration-plan",
        "sourceArtifactId": "skill/data/migrations/review-database-migration-plan",
        "sourceField": "summary"
      },
      {
        "id": "02-review-schema-evolution",
        "effect": "require",
        "action": "review-schema-evolution",
        "sourceArtifactId": "skill/data/schemas/review-schema-evolution",
        "sourceField": "summary"
      },
      {
        "id": "03-apply-destructive-migration",
        "effect": "require",
        "action": "apply-destructive-migration",
        "sourceArtifactId": "hook/data/migrations/migration-safety-guard",
        "sourceField": "summary"
      }
    ]
  },
  "relationships": {
    "composesWith": [],
    "conflictsWith": [],
    "supersedes": [],
    "prerequisites": [],
    "packIds": []
  },
  "operational": {
    "behavior": "advisory",
    "failurePolicy": "stop-and-report",
    "latencyClass": "immediate",
    "dataRetention": "none"
  },
  "adapters": {
    "claude-code": "adapters/claude-code.json",
    "cursor": "adapters/cursor.json",
    "github-copilot": "adapters/github-copilot.json"
  }
}
