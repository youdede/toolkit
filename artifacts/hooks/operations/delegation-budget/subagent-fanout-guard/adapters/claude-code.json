{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "claude-code",
  "scopes": [
    "project"
  ],
  "files": [
    {
      "from": "targets/claude-code/subagent-fanout-guard.mjs",
      "to": "hooks/youdede/subagent-fanout-guard.mjs",
      "executable": true
    }
  ],
  "settingsPatch": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Task|Agent",
          "description": "[youdede:subagent-fanout-guard] Cap per-session subagent delegation using a bounded transcript count",
          "hooks": [
            {
              "type": "command",
              "command": "node \"{claudeRoot}/hooks/youdede/subagent-fanout-guard.mjs\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
