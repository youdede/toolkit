{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "claude-code",
  "scopes": ["project"],
  "files": [
    {
      "from": "targets/claude-code/worktree-removal-evidence-guard.mjs",
      "to": "hooks/youdede/worktree-removal-evidence-guard.mjs",
      "executable": true
    }
  ],
  "settingsPatch": {
    "hooks": {
      "WorktreeRemove": [
        {
          "description": "[youdede:worktree-removal-evidence-guard] Observe dirty worktree state before removal",
          "hooks": [
            {
              "type": "command",
              "command": "node \"{claudeRoot}/hooks/youdede/worktree-removal-evidence-guard.mjs\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
