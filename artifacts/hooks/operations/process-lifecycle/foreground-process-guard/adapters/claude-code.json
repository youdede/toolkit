{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "claude-code",
  "scopes": [
    "project"
  ],
  "files": [
    {
      "from": "targets/claude-code/foreground-process-guard.mjs",
      "to": "hooks/youdede/foreground-process-guard.mjs",
      "executable": true
    }
  ],
  "settingsPatch": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash|PowerShell",
          "description": "[youdede:foreground-process-guard] Block recognizable indefinite development processes launched in the foreground",
          "hooks": [
            {
              "type": "command",
              "command": "node \"{claudeRoot}/hooks/youdede/foreground-process-guard.mjs\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
