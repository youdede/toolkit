{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "codex",
  "scopes": [
    "project"
  ],
  "files": [
    {
      "from": "targets/claude-code/foreground-process-guard.mjs",
      "to": "hooks/youdede/foreground-process-guard.mjs",
      "executable": true
    }
  ],
  "settingsPatch": {
    "path": "hooks.json",
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "node \"{codexRoot}/hooks/youdede/foreground-process-guard.mjs\"",
              "timeout": 10,
              "statusMessage": "[youdede:foreground-process-guard] Evaluating foreground process guard."
            }
          ]
        }
      ]
    }
  },
  "bindings": [
    {
      "event": "PreToolUse",
      "matcher": "Bash"
    }
  ],
  "stability": "stable",
  "limitations": [
    "This native tranche covers shell-command interception only; project hook definitions require Codex trust review before execution."
  ]
}
