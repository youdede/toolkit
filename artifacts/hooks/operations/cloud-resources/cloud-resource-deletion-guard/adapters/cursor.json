{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "cursor",
  "scopes": [
    "project"
  ],
  "files": [
    {
      "from": "targets/claude-code/cloud-resource-deletion-guard.mjs",
      "to": "hooks/youdede/cloud-resource-deletion-guard.core.mjs",
      "executable": true
    },
    {
      "root": "package",
      "from": "scripts/runtime/hook-command-bridge.mjs",
      "to": "hooks/youdede/cloud-resource-deletion-guard.mjs",
      "executable": true
    }
  ],
  "settingsPatch": {
    "path": "hooks.json",
    "hooks": {
      "preToolUse": [
        {
          "type": "command",
          "command": "node \"{cursorRoot}/hooks/youdede/cloud-resource-deletion-guard.mjs\" --target cursor --failure-policy fail-closed --marker \"[youdede:cloud-resource-deletion-guard]\"",
          "timeout": 10,
          "failClosed": true,
          "matcher": "Shell"
        }
      ]
    }
  },
  "bindings": [
    {
      "event": "preToolUse",
      "matcher": "Shell"
    }
  ],
  "stability": "stable",
  "limitations": [
    "This first native tranche covers the documented Shell payload only and does not depend on the optional Claude compatibility loader."
  ]
}
