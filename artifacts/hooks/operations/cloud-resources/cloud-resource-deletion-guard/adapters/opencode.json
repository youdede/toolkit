{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "opencode",
  "scopes": [
    "project",
    "user"
  ],
  "files": [
    {
      "from": "targets/claude-code/cloud-resource-deletion-guard.mjs",
      "to": "plugins/youdede-cloud-resource-deletion-guard.core.mjs",
      "executable": true
    },
    {
      "root": "package",
      "from": "scripts/runtime/opencode-guard-plugin.js",
      "to": "plugins/youdede-cloud-resource-deletion-guard.js"
    }
  ],
  "bindings": [
    {
      "event": "tool.execute.before",
      "matcher": "bash|shell"
    }
  ],
  "stability": "stable",
  "limitations": [
    "The adapter enforces shell calls at tool.execute.before, requires Node.js on PATH, and becomes active after OpenCode reloads local plugins."
  ]
}
