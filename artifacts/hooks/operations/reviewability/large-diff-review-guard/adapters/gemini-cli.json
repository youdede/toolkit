{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "gemini-cli",
  "scopes": [
    "project"
  ],
  "files": [
    {
      "from": "targets/claude-code/large-diff-review-guard.mjs",
      "to": "hooks/youdede/large-diff-review-guard.core.mjs",
      "executable": true
    },
    {
      "root": "package",
      "from": "scripts/runtime/hook-command-bridge.mjs",
      "to": "hooks/youdede/large-diff-review-guard.mjs",
      "executable": true
    }
  ],
  "settingsPatch": {
    "path": "settings.json",
    "hooks": {
      "BeforeTool": [
        {
          "matcher": "run_shell_command",
          "sequential": true,
          "hooks": [
            {
              "name": "youdede-large-diff-review-guard",
              "type": "command",
              "command": "node \"{geminiRoot}/hooks/youdede/large-diff-review-guard.mjs\" --target gemini-cli --failure-policy fail-closed",
              "timeout": 20000,
              "description": "[youdede:large-diff-review-guard] Require a smaller staged change when a commit exceeds bounded reviewability thresholds."
            }
          ]
        }
      ]
    }
  },
  "bindings": [
    {
      "event": "BeforeTool",
      "matcher": "run_shell_command"
    }
  ],
  "stability": "preview",
  "limitations": [
    "This first native tranche covers shell-command interception only; write, MCP, prompt, and lifecycle boundaries remain withheld pending fixtures."
  ]
}
