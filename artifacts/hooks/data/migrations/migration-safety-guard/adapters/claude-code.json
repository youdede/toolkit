{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "claude-code",
  "scopes": ["project"],
  "files": [
    {
      "from": "targets/claude-code/migration-safety-guard.mjs",
      "to": "hooks/youdede/migration-safety-guard.mjs",
      "executable": true
    }
  ],
  "settingsPatch": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash|Write|Edit",
          "description": "[youdede:migration-safety-guard] Gate destructive migration actions",
          "hooks": [
            {
              "type": "command",
              "command": "node \"{claudeRoot}/hooks/youdede/migration-safety-guard.mjs\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
