{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "claude-code",
  "scopes": ["project"],
  "files": [
    {
      "from": "targets/claude-code/prompt-secret-guard.mjs",
      "to": "hooks/youdede/prompt-secret-guard.mjs",
      "executable": true
    }
  ],
  "settingsPatch": {
    "hooks": {
      "UserPromptSubmit": [
        {
          "description": "[youdede:prompt-secret-guard] Reject high-confidence credentials before prompt processing",
          "hooks": [
            {
              "type": "command",
              "command": "node \"{claudeRoot}/hooks/youdede/prompt-secret-guard.mjs\"",
              "timeout": 5
            }
          ]
        }
      ]
    }
  }
}
