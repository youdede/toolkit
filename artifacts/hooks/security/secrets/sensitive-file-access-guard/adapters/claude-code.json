{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "claude-code",
  "scopes": ["project"],
  "files": [
    {
      "from": "targets/claude-code/sensitive-file-access-guard.mjs",
      "to": "hooks/youdede/sensitive-file-access-guard.mjs",
      "executable": true
    }
  ],
  "settingsPatch": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Bash|PowerShell",
          "description": "[youdede:sensitive-file-access-guard] Protect high-confidence local secret paths",
          "hooks": [
            {
              "type": "command",
              "command": "node \"{claudeRoot}/hooks/youdede/sensitive-file-access-guard.mjs\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
