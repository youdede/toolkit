{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "claude-code",
  "scopes": ["project"],
  "files": [
    {
      "from": "targets/claude-code/commit-guard.mjs",
      "to": "hooks/youdede/commit-guard.mjs",
      "executable": true
    }
  ],
  "settingsPatch": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "description": "[youdede:commit-guard] Inspect staged content before git commit",
          "hooks": [
            {
              "type": "command",
              "command": "node \"{claudeRoot}/hooks/youdede/commit-guard.mjs\"",
              "timeout": 30
            }
          ]
        }
      ]
    }
  }
}

