{
  "$schema": "../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "claude-code",
  "scopes": [
    "project"
  ],
  "files": [
    {
      "from": "COMMAND.md",
      "to": "commands/audit-release-evidence.md"
    },
    {
      "from": "scripts/check-preconditions.mjs",
      "to": "commands/youdede/audit-release-evidence/check-preconditions.mjs",
      "executable": true
    },
    {
      "from": "preconditions.json",
      "to": "commands/youdede/audit-release-evidence/preconditions.json"
    },
    {
      "root": "package",
      "from": "scripts/runtime/command-precondition.mjs",
      "to": "commands/youdede/lib/command-precondition.mjs"
    }
  ]
}
