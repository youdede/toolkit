{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "claude-code",
  "scopes": [
    "project"
  ],
  "files": [
    {
      "from": "COMMAND.md",
      "to": "commands/assemble-review-brief.md"
    },
    {
      "from": "scripts/check-preconditions.mjs",
      "to": "commands/youdede/assemble-review-brief/check-preconditions.mjs",
      "executable": true
    },
    {
      "from": "preconditions.json",
      "to": "commands/youdede/assemble-review-brief/preconditions.json"
    },
    {
      "root": "package",
      "from": "scripts/runtime/command-precondition.mjs",
      "to": "commands/youdede/lib/command-precondition.mjs"
    }
  ]
}
