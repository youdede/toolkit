{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "github-copilot",
  "scopes": [
    "project",
    "user"
  ],
  "files": [
    {
      "from": "SKILL.md",
      "to": "skills/{slug}/SKILL.md"
    },
    {
      "from": "scripts",
      "to": "skills/{slug}/scripts"
    }
  ],
  "stability": "preview",
  "limitations": [
    "Availability depends on the GitHub Copilot surface and version that loads Agent Skills."
  ]
}
