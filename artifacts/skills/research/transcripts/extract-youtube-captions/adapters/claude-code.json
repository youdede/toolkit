{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "claude-code",
  "scopes": [
    "project",
    "user"
  ],
  "files": [
    {
      "from": "SKILL.md",
      "to": "skills/{slug}/SKILL.md"
    },
    {
      "from": "scripts",
      "to": "skills/{slug}/scripts"
    }
  ]
}
