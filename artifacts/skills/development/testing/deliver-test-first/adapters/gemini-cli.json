{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "gemini-cli",
  "scopes": [
    "project",
    "user"
  ],
  "files": [
    {
      "from": "SKILL.md",
      "to": "skills/{slug}/SKILL.md"
    },
    {
      "from": "references",
      "to": "skills/{slug}/references"
    }
  ],
  "stability": "stable",
  "limitations": []
}
