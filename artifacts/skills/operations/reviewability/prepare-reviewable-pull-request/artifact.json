{
  "$schema": "../../../../../schema/artifact.schema.json",
  "schemaVersion": 1,
  "id": "skill/operations/reviewability/prepare-reviewable-pull-request",
  "slug": "prepare-reviewable-pull-request",
  "name": "Prepare Reviewable Pull Request",
  "version": "1.3.0",
  "kind": "skill",
  "summary": "Prepare a focused pull-request narrative whose claims trace to the diff, tests, risks, and review order.",
  "description": "Prepare a reviewable pull-request package from a verified branch diff, repository policy, test evidence, migration risk, and reviewer needs without publishing it. Use after implementation is complete and before opening or updating a pull request.",
  "domain": "operations",
  "category": "reviewability",
  "capabilities": [
    "plan",
    "verify"
  ],
  "problems": [
    "diff-reviewability",
    "branch-integration"
  ],
  "frameworks": [
    "agnostic"
  ],
  "languages": [
    "agnostic"
  ],
  "lifecycle": [
    "review",
    "handoff"
  ],
  "risk": "medium",
  "license": "MIT",
  "authors": [
    "Youdede"
  ],
  "refuses": [
    "It does not publish, push, commit, assign reviewers, or mutate remote state without explicit authorization.",
    "It does not hide failing checks, scope drift, generated changes, migrations, or unresolved security and data risks.",
    "It does not claim the pull request is ready or approved solely because its description is complete."
  ],
  "execution": {
    "mode": "prompt",
    "entrypoints": []
  },
  "relationships": {
    "composesWith": [
      "command/development/workflow/assemble-review-brief",
      "hook/operations/reviewability/large-diff-review-guard",
      "skill/development/code-quality/deliver-incremental-change",
      "skill/development/code-quality/evaluate-code-review-feedback",
      "skill/development/code-quality/request-independent-code-review",
      "subagent/development/code-quality/refactor-equivalence-reviewer"
    ],
    "conflictsWith": [],
    "supersedes": [],
    "prerequisites": [],
    "packIds": [
      "pack/daily-driver",
      "pack/reviewable-change"
    ]
  },
  "operational": {
    "behavior": "advisory",
    "failurePolicy": "stop-and-report",
    "latencyClass": "bounded",
    "dataRetention": "runtime-managed"
  },
  "adapters": {
    "claude-code": "adapters/claude-code.json",
    "codex": "adapters/codex.json",
    "gemini-cli": "adapters/gemini-cli.json",
    "github-copilot": "adapters/github-copilot.json",
    "cursor": "adapters/cursor.json",
    "opencode": "adapters/opencode.json"
  }
}
