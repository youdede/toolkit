{
  "$schema": "../../../../../../schema/adapter.schema.json",
  "schemaVersion": 1,
  "target": "cursor",
  "scopes": ["project"],
  "stability": "stable",
  "limitations": ["The server is project-scoped and requires Node.js 20 or newer on the local machine."],
  "files": [
    {"from": "runtime/readonly-mcp-server.mjs", "to": ".youdede/mcp/runtime.mjs", "executable": true},
    {"from": "server.json", "to": ".youdede/mcp/workspace-files-readonly/server.json"},
    {"from": "THREAT.md", "to": ".youdede/mcp/workspace-files-readonly/THREAT.md"}
  ],
  "mcpPatch": {"path": ".cursor/mcp.json", "servers": {"youdede-workspace-files-readonly": {"command": "node", "args": [".youdede/mcp/runtime.mjs", "--profile", ".youdede/mcp/workspace-files-readonly/server.json"]}}}
}
