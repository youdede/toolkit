{
  "$schema": "../../../../../../schema/evaluation.schema.json",
  "schemaVersion": 1,
  "artifactId": "subagent/operations/cloud-resources/cloud-cost-finops-analyst",
  "cases": [
    {
      "id": "positive-cloud-cost-finops",
