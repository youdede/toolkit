{
  "$schema": "../../../../../schema/artifact.schema.json",
  "schemaVersion": 1,
  "id": "subagent/development/testing/test-gap-reviewer",
  "slug": "test-gap-reviewer",
  "name": "Test gap reviewer",
  "version": "1.0.0",
  "kind": "subagent",
  "summary": "Find meaningful unproved behaviors in a bounded change without writing or running tests.",
  "description": "A read-only Claude Code specialist that maps intended behavior to tests and reports high-confidence regression, boundary, error, integration, and durability gaps.",
  "domain": "development",
  "category": "testing",
  "problems": [
    "test-gaps",
    "regression-prevention"
  ],
  "frameworks": [
    "agnostic"
  ],
  "languages": [
    "agnostic"
  ],
  "lifecycle": [
    "review"
  ],
  "risk": "low",
  "license": "MIT",
  "authors": [
    "youdede contributors"
  ],
  "refuses": [
    "It does not write tests, snapshots, fixtures, production code, or configuration.",
    "It does not claim execution or coverage results that were not supplied as evidence.",
    "It does not expand a bounded test review into unrelated general code review."
  ],
  "execution": {
    "mode": "prompt",
    "entrypoints": []
  },
  "adapters": {
    "claude-code": "adapters/claude-code.json",
    "gemini-cli": "adapters/gemini-cli.json",
    "github-copilot": "adapters/github-copilot.json",
    "opencode": "adapters/opencode.json"
  },
  "capabilities": [
    "assess"
  ],
  "relationships": {
    "composesWith": [
      "skill/development/testing/assess-mutation-test-value",
      "skill/development/testing/design-property-and-fuzz-tests"
    ],
    "conflictsWith": [],
    "supersedes": [],
    "prerequisites": [],
    "packIds": []
  },
  "operational": {
    "behavior": "advisory",
    "failurePolicy": "stop-and-report",
    "latencyClass": "bounded",
    "dataRetention": "runtime-managed"
  }
}
