{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "description": "[youdede:migration-safety-guard] Gate destructive migration actions",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/youdede/migration-safety-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
