{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "description": "[youdede:compact-readiness-guard] Warn before compaction hides unverified state",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/youdede/compact-readiness-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "description": "[youdede:session-checkpoint-guard] Record a hash-chained session-end receipt",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/youdede/session-checkpoint-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "description": "[youdede:session-restore-guard] Surface a bounded verified ledger summary",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/youdede/session-restore-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
