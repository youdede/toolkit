{
  "mcpServers": {
    "youdede-github-readonly": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server@sha256:508a0857ec762b1ab1cece29193345b501fab1dd9d1228a7b617062954cecac6",
        "stdio",
        "--read-only",
        "--toolsets",
        "repos,pull_requests,issues,actions"
      ]
    }
  }
}
