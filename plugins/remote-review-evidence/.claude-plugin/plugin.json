{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "remote-review-evidence",
  "displayName": "Remote review evidence",
  "version": "1.0.1",
  "description": "Collect bounded GitHub evidence in read-only mode and turn failing CI evidence into a traceable diagnosis.",
  "author": {
    "name": "Youdede",
    "url": "https://github.com/youdede/toolkit"
  },
  "homepage": "https://github.com/youdede/toolkit/blob/main/packs/remote-review-evidence/pack.json",
  "repository": "https://github.com/youdede/toolkit",
  "license": "MIT",
  "documentationUrl": "https://youdede.studio/en/toolkit",
  "supportUrl": "https://github.com/youdede/toolkit/blob/main/SUPPORT.md",
  "privacyPolicyUrl": "https://github.com/youdede/toolkit/blob/main/PRIVACY.md",
  "keywords": [
    "remote-review-evidence",
    "ci-failure-diagnosis",
    "ledger-linked-evidence",
    "behaviorally-evaluated"
  ],
  "userConfig": {
    "github_personal_access_token": {
      "type": "string",
      "title": "GITHUB_PERSONAL_ACCESS_TOKEN",
      "description": "Passed to MCP server 'youdede-github-readonly' as GITHUB_PERSONAL_ACCESS_TOKEN.",
      "sensitive": true,
      "required": true
    }
  },
  "metadata": {
    "catalogId": "pack/remote-review-evidence",
    "memberArtifactIds": [
      "command/operations/ci-cd/diagnose-ci-failure",
      "skill/operations/ci-cd/debug-ci-failure",
      "subagent/operations/ci-cd/ci-failure-analyst",
      "mcp-server/development/agent-tooling/github-readonly"
    ],
    "refusalCount": 12,
    "evidenceBadges": [
      "ledger-linked-evidence",
      "behaviorally-evaluated"
    ]
  }
}
