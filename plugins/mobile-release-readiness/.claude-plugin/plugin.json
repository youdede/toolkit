  "description": "Review mobile release evidence, accessibility, and reliability. Release guards stop npm, pnpm, yarn, cargo, twine, and gh release publication, not fastlane, EAS, altool, or Gradle.",
  "author": {
    "name": "Youdede",
    "url": "https://github.com/udede/toolkit"
  },
  "homepage": "https://github.com/udede/toolkit/blob/main/packs/mobile-release-readiness/pack.json",
  "repository": "https://github.com/udede/toolkit",
  "license": "MIT",
  "keywords": [
    "mobile-release-evidence",
    "safe-publication",
    "ledger-linked-evidence",
    "behaviorally-evaluated"
  ],
  "hooks": "./hooks/hooks.json",
  "metadata": {
    "catalogId": "pack/mobile-release-readiness",
    "memberArtifactIds": [
      "skill/operations/release/verify-mobile-release-readiness",
      "subagent/development/testing/mobile-reliability-accessibility-reviewer",
      "hook/operations/repository-state/release-clean-state-guard",
      "hook/operations/versioning/release-version-consistency-guard"
