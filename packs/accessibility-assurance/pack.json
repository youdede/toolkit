      "role": "collector",
      "required": true
    },
    {
      "artifactId": "skill/design/accessibility/test-screen-reader-journey",
      "role": "verifier",
      "required": true
    },
    {
      "artifactId": "skill/design/accessibility/verify-cognitive-access-barriers",
      "role": "verifier",
      "required": true
    },
    {
      "artifactId": "subagent/design/accessibility/accessibility-conformance-reviewer",
      "role": "specialist",
      "required": true
