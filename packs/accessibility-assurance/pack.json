      "required": true
    },
    {
      "artifactId": "hook/design/keyboard-focus/focus-style-regression-guard",
      "role": "enforcement",
      "required": true
    },
    {
      "artifactId": "hook/design/semantic-markup/accessibility-attribute-regression-guard",
      "role": "enforcement",
      "required": true
