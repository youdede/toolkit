{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "id": "pack/data-change-safety",
  "slug": "data-change-safety",
  "name": "Data change safety",
  "version": "1.1.1",
  "summary": "Review schema and migration changes with deterministic safety checks and independent risk analysis.",
  "outcomes": [
    "compatible-data-change",
    "migration-safety"
  ],
  "evidence": {
    "reportSchema": "../../schema/pack-evidence.schema.json",
    "ledgerLinkRequired": true,
    "outcomeEvidence": [
      {"outcome": "compatible-data-change", "memberArtifactIds": ["skill/data/schemas/review-schema-evolution", "subagent/data/migrations/migration-risk-reviewer"]},
      {"outcome": "migration-safety", "memberArtifactIds": ["hook/security/application-security/shell-command-guard", "hook/data/migrations/migration-safety-guard", "skill/data/migrations/review-database-migration-plan"]}
    ]
  },
  "members": [
    {
      "artifactId": "skill/data/migrations/review-database-migration-plan",
      "role": "procedure",
      "required": true
    },
    {
      "artifactId": "skill/data/schemas/review-schema-evolution",
      "role": "verifier",
      "required": true
    },
    {
      "artifactId": "subagent/data/migrations/migration-risk-reviewer",
      "role": "specialist",
      "required": true
    },
    {
      "artifactId": "hook/data/migrations/migration-safety-guard",
      "role": "enforcement",
      "required": true
    },
    {
      "artifactId": "hook/security/application-security/shell-command-guard",
      "role": "enforcement",
      "required": true
    }
  ]
}
