{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "id": "pack/release-readiness",
  "slug": "release-readiness",
  "name": "Release readiness",
  "version": "1.2.1",
  "summary": "Build an evidence-backed release decision and stop publication from unsafe repository state.",
  "outcomes": [
    "release-evidence",
    "safe-publication"
  ],
  "evidence": {
    "reportSchema": "../../schema/pack-evidence.schema.json",
    "ledgerLinkRequired": true,
    "outcomeEvidence": [
      {"outcome": "release-evidence", "memberArtifactIds": ["command/development/workflow/audit-release-evidence", "skill/operations/release/verify-production-release", "subagent/operations/release/release-evidence-verifier", "subagent/operations/release/release-risk-reviewer"]},
      {"outcome": "safe-publication", "memberArtifactIds": ["hook/security/application-security/shell-command-guard", "hook/operations/package-publication/package-publish-guard", "hook/operations/repository-state/release-clean-state-guard", "hook/operations/versioning/release-version-consistency-guard"]}
    ]
  },
  "members": [
    {
      "artifactId": "command/development/workflow/audit-release-evidence",
      "role": "entrypoint",
      "required": true
    },
    {
      "artifactId": "skill/operations/release/verify-production-release",
      "role": "procedure",
      "required": true
    },
    {
      "artifactId": "subagent/operations/release/release-risk-reviewer",
      "role": "specialist",
      "required": true
    },
    {
      "artifactId": "subagent/operations/release/release-evidence-verifier",
      "role": "verifier",
      "required": true
    },
    {
      "artifactId": "hook/operations/repository-state/release-clean-state-guard",
      "role": "enforcement",
      "required": true
    },
    {
      "artifactId": "hook/operations/versioning/release-version-consistency-guard",
      "role": "enforcement",
      "required": true
    },
    {
      "artifactId": "hook/security/application-security/shell-command-guard",
      "role": "enforcement",
      "required": true
    },
    {
      "artifactId": "hook/operations/package-publication/package-publish-guard",
      "role": "enforcement",
      "required": true
    }
  ]
}
