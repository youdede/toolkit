{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "id": "pack/mobile-release-readiness",
  "slug": "mobile-release-readiness",
  "name": "Mobile release readiness",
  "version": "1.0.1",
  "summary": "Review mobile release evidence, accessibility, and reliability. Release guards stop npm, pnpm, yarn, cargo, twine, and gh release publication, not fastlane, EAS, altool, or Gradle.",
  "outcomes": [
    "mobile-release-evidence",
    "safe-publication"
  ],
  "evidence": {
    "reportSchema": "../../schema/pack-evidence.schema.json",
    "ledgerLinkRequired": true,
    "outcomeEvidence": [
      {"outcome": "mobile-release-evidence", "memberArtifactIds": ["skill/operations/release/verify-mobile-release-readiness", "subagent/development/testing/mobile-reliability-accessibility-reviewer"]},
      {"outcome": "safe-publication", "memberArtifactIds": ["hook/operations/repository-state/release-clean-state-guard", "hook/operations/versioning/release-version-consistency-guard"]}
    ]
  },
  "members": [
    {
      "artifactId": "skill/operations/release/verify-mobile-release-readiness",
      "role": "procedure",
      "required": true
    },
    {
      "artifactId": "subagent/development/testing/mobile-reliability-accessibility-reviewer",
      "role": "specialist",
      "required": true
    },
    {
      "artifactId": "hook/operations/repository-state/release-clean-state-guard",
      "role": "enforcement",
      "required": true
    },
    {
      "artifactId": "hook/operations/versioning/release-version-consistency-guard",
      "role": "enforcement",
      "required": true
    }
  ]
}
