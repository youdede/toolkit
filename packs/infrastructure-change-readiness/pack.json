{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "id": "pack/infrastructure-change-readiness",
  "slug": "infrastructure-change-readiness",
  "name": "Infrastructure change readiness",
  "version": "1.0.1",
  "summary": "Plan a staged infrastructure change and independently review lifecycle, blast-radius, and recovery evidence.",
