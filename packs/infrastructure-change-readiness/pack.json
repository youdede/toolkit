      {"outcome": "staged-infrastructure-change", "memberArtifactIds": ["skill/operations/infrastructure/plan-infrastructure-change", "subagent/operations/infrastructure/infrastructure-change-reviewer"]}
    ]
  },
  "members": [
    {
      "artifactId": "skill/operations/infrastructure/plan-infrastructure-change",
      "role": "procedure",
      "required": true
    },
    {
      "artifactId": "subagent/operations/infrastructure/infrastructure-change-reviewer",
      "role": "specialist",
      "required": true
    },
    {
      "artifactId": "subagent/operations/resilience/disaster-recovery-readiness-auditor",
      "role": "verifier",
      "required": true
    }
  ]
