{
  "name": "@youdede/toolkit",
  "version": "0.5.0",
  "description": "Open, individually installable skills, hooks, subagents, commands, contexts, and MCP profiles for coding agents.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youdede/toolkit.git"
  },
  "homepage": "https://youdede.studio/en/toolkit",
  "bugs": {
    "url": "https://github.com/youdede/toolkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "youdede-toolkit": "bin/youdede-toolkit.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "CITATION.cff",
    "LICENSE",
    "NOTICE",
    "artifacts",
    "bin",
    "catalog",
    "docs",
    "!docs/assets",
    "packs",
    "quality",
    "!quality/hook-verdicts.json",
    "!quality/hook-verdict-quarantine.json",
    "!quality/everyday-commands.txt",
    "schema",
    "scripts/build-release-benchmark.mjs",
    "scripts/generate-contexts.mjs",
    "scripts/generate-capability-docs.mjs",
    "scripts/generate-mcp.mjs",
    "scripts/generate-marketplaces.mjs",
    "scripts/generate-pack-evaluations.mjs",
    "scripts/generate-catalog-docs.mjs",
    "scripts/runtime",
    "scripts/verify-secrets.mjs",
    "scripts/verify-package-command.mjs",
    "scripts/verify-mcp.mjs",
    "scripts/test-github-mcp-live.mjs",
    "scripts/validate-pack-evaluations.mjs",
    "scripts/verify-pack-evidence.mjs",
    "scripts/validate-changelog.mjs",
    "scripts/validate-evaluations.mjs",
    "scripts/validate-output-contracts.mjs",
    "scripts/validate-release-readiness.mjs",
    "scripts/lib"
  ],
  "scripts": {
    "setup:repo": "node scripts/setup-repository.mjs",
    "catalog": "node scripts/generate-catalog.mjs",
    "catalog:docs": "node scripts/generate-catalog-docs.mjs",
    "capability:docs": "node scripts/generate-capability-docs.mjs",
    "contexts": "node scripts/generate-contexts.mjs",
    "mcp": "node scripts/generate-mcp.mjs",
    "marketplaces": "node scripts/generate-marketplaces.mjs",
    "pack-evaluations": "node scripts/generate-pack-evaluations.mjs",
    "shared-hooks": "node scripts/generate-shared-hooks.mjs",
    "check:shared-hooks": "node scripts/generate-shared-hooks.mjs --check",
    "hook-verdicts": "node scripts/record-hook-verdicts.mjs",
    "check:hook-verdicts": "node scripts/record-hook-verdicts.mjs --check --processes",
    "check:catalog": "node scripts/generate-catalog.mjs --check",
    "check:reason-translations": "node scripts/check-reason-translations.mjs",
    "check:narrative-translations": "node scripts/check-narrative-translations.mjs",
    "check:catalog-docs": "node scripts/generate-catalog-docs.mjs --check",
    "check:capability-docs": "node scripts/generate-capability-docs.mjs --check",
    "check:contexts": "node scripts/generate-contexts.mjs --check",
    "check:mcp": "node scripts/verify-mcp.mjs && node scripts/generate-mcp.mjs --check",
    "test:mcp:live": "node scripts/test-github-mcp-live.mjs",
    "check:marketplaces": "node scripts/generate-marketplaces.mjs --check",
    "check:pack-evaluations": "node scripts/generate-pack-evaluations.mjs --check && node scripts/validate-pack-evaluations.mjs",
    "integrity": "node scripts/generate-integrity.mjs",
    "check:integrity": "node scripts/generate-integrity.mjs --check",
    "check:legal": "node scripts/verify-legal.mjs",
    "check:changelog": "node scripts/validate-changelog.mjs",
    "check:evaluations": "node scripts/validate-evaluations.mjs",
    "check:contracts": "node scripts/validate-output-contracts.mjs",
    "check:quality": "node scripts/validate-release-readiness.mjs --structural-only",
    "check:readiness": "node scripts/validate-release-readiness.mjs",
    "benchmark:release:build": "node scripts/build-release-benchmark.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "check:package": "node scripts/verify-package.mjs",
    "check:secrets": "node scripts/verify-secrets.mjs --tracked --package",
    "check:secrets:history": "node scripts/verify-secrets.mjs --history",
    "prepublishOnly": "npm run check && npm run check:readiness",
    "validate": "node scripts/validate.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run validate && npm run check:shared-hooks && npm run check:contexts && npm run check:mcp && npm run check:marketplaces && npm run check:evaluations && npm run check:pack-evaluations && npm run check:contracts && npm run check:quality && npm run check:catalog && npm run check:reason-translations && npm run check:narrative-translations && npm run check:integrity && npm run check:catalog-docs && npm run check:capability-docs && npm run check:doc-stats && npm run check:legal && npm run check:changelog && npm run check:secrets && npm run check:package && npm test",
    "docs:stats": "node scripts/generate-doc-stats.mjs",
    "check:doc-stats": "node scripts/generate-doc-stats.mjs --check"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "github-copilot",
    "hooks",
    "opencode",
    "subagents",
    "developer-tools"
  ]
}
