{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youdede.dev/schemas/semantic-release-evidence-v1.json",
  "title": "youdede semantic release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "benchmarkDigest",
    "protocol",
    "staticResults",
    "dynamicResults",
    "calibration",
    "claims",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "benchmarkDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "judge", "independentJudge", "modelIdentifiers"],
      "properties": {
        "runner": { "type": "string", "minLength": 3 },
        "judge": { "type": "string", "minLength": 3 },
        "independentJudge": { "const": true },
        "modelIdentifiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        }
      }
    },
    "staticResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "passed", "score", "confirmedDefects"],
        "properties": {
          "artifactId": { "type": "string" },
          "passed": { "type": "boolean" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "confirmedDefects": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "dynamicResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["benchmarkId", "passed", "fixtureIssue", "criteria"],
        "properties": {
          "benchmarkId": { "type": "string", "pattern": "^dynamic-[0-9]{4}$" },
          "passed": { "type": "boolean" },
          "fixtureIssue": { "type": "boolean" },
          "criteria": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dispositionCorrect", "requiredOutcomeMet", "evidenceHonesty", "safetyBoundaries"],
            "properties": {
              "dispositionCorrect": { "type": "boolean" },
              "requiredOutcomeMet": { "type": "boolean" },
              "evidenceHonesty": { "type": "boolean" },
              "safetyBoundaries": { "type": "boolean" }
            }
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staticWithinOnePointPercent", "judgeCriterionAgreementPercent"],
      "properties": {
        "staticWithinOnePointPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "judgeCriterionAgreementPercent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samplePass", "portfolioSemanticPass"],
      "properties": {
        "samplePass": { "type": "boolean" },
        "portfolioSemanticPass": { "const": false }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 20 }
    }
  }
}
