{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youdede.dev/schemas/toolkit-artifact-v1.json",
  "title": "youdede toolkit artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "name",
    "version",
    "kind",
    "summary",
    "description",
    "domain",
    "category",
    "capabilities",
    "problems",
    "frameworks",
    "languages",
    "lifecycle",
    "risk",
    "license",
    "authors",
    "refuses",
    "execution",
    "relationships",
    "operational",
    "adapters"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^(skill|hook|subagent|command|context|mcp-server)/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$"
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "name": { "type": "string", "minLength": 3, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "kind": { "enum": ["skill", "hook", "subagent", "command", "context", "mcp-server"] },
    "summary": { "type": "string", "minLength": 20, "maxLength": 140 },
    "description": { "type": "string", "minLength": 40, "maxLength": 600 },
    "domain": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "category": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "capabilities": { "$ref": "#/$defs/nonEmptySlugs" },
    "problems": { "$ref": "#/$defs/nonEmptySlugs" },
    "frameworks": { "$ref": "#/$defs/nonEmptySlugs" },
    "languages": { "$ref": "#/$defs/nonEmptySlugs" },
    "lifecycle": { "$ref": "#/$defs/nonEmptySlugs" },
    "risk": { "enum": ["low", "medium", "high"] },
    "license": { "const": "MIT" },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "refuses": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 15 }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "entrypoints"],
      "properties": {
        "mode": { "enum": ["prompt", "hybrid", "deterministic"] },
        "entrypoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/entrypoint" }
        }
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composesWith", "conflictsWith", "supersedes", "prerequisites", "packIds"],
      "properties": {
        "composesWith": { "$ref": "#/$defs/artifactIds" },
        "conflictsWith": { "$ref": "#/$defs/artifactIds" },
        "supersedes": { "$ref": "#/$defs/artifactIds" },
        "prerequisites": { "$ref": "#/$defs/artifactIds" },
        "packIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^pack/[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "failurePolicy", "latencyClass", "dataRetention"],
      "properties": {
        "behavior": { "enum": ["advisory", "enforcing", "observing"] },
        "failurePolicy": { "enum": ["stop-and-report", "fail-closed", "fail-open"] },
        "latencyClass": { "enum": ["immediate", "bounded", "background"] },
        "dataRetention": { "enum": ["none", "runtime-managed", "local-bounded"] }
      }
    },
    "adapters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^adapters/[a-z0-9-]+\\.json$"
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation", "toolAuthority", "produces", "requires", "flags"],
      "properties": {
        "invocation": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
        "toolAuthority": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }
        },
        "produces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 10, "maxLength": 200 }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 10, "maxLength": 200 }
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "effect", "description"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "effect": { "const": "narrow" },
              "description": { "type": "string", "minLength": 15, "maxLength": 200 }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "precedence", "provenance"],
      "properties": {
        "scope": { "enum": ["always", "glob"] },
        "globs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
        },
        "precedence": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(skill|hook|subagent|command|context|mcp-server)/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$"
          }
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "egress", "secretAccess", "trustBoundary", "pinnedTools"],
      "properties": {
        "transport": { "enum": ["stdio", "sse", "http"] },
        "egress": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(none|[a-z0-9]+(?:[.-][a-z0-9]+)+(?::[0-9]+)?)$" }
        },
        "secretAccess": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(none|[A-Z][A-Z0-9_]*)$" }
        },
        "trustBoundary": { "type": "string", "minLength": 40, "maxLength": 400 },
        "pinnedTools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "descriptionHash"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$" },
              "descriptionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "command" } } },
      "then": { "required": ["command"] }
    },
    {
      "if": { "properties": { "kind": { "const": "context" } } },
      "then": { "required": ["context"] }
    },
    {
      "if": { "properties": { "kind": { "const": "mcp-server" } } },
      "then": { "required": ["mcpServer"] }
    }
  ],
  "$defs": {
    "nonEmptySlugs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "artifactIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(skill|hook|subagent|command|context|mcp-server)/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$"
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "runtime", "purpose", "sideEffects"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "runtime": { "enum": ["node", "python", "shell", "runtime"] },
        "purpose": { "type": "string", "minLength": 20, "maxLength": 200 },
        "sideEffects": { "enum": ["none", "read-only", "writes-files", "external"] }
      }
    }
  }
}
