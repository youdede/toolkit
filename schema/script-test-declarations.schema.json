{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youdede.dev/schemas/script-test-declarations-v1.json",
  "title": "youdede executable artifact test declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "suites"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/suite" }
    }
  },
  "$defs": {
    "artifactId": {
      "type": "string",
      "pattern": "^(skill|hook|subagent)/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$"
    },
    "anchor": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "coverage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/anchor" },
      "propertyNames": { "pattern": "^[a-z]+(?:-[a-z]+)*$" }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifactIds", "testFiles", "coverage"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "artifactIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifactId" }
        },
        "testFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tests/[a-z0-9-]+\\.test\\.mjs$"
          }
        },
        "coverage": { "$ref": "#/$defs/coverage" }
      }
    }
  }
}
