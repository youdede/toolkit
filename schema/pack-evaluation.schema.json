{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youdede.dev/schemas/pack-evaluation-v1.json",
  "title": "youdede pack behavioral evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "packId", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "packId": { "type": "string", "pattern": "^pack/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "scenario", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "type": { "enum": ["positive", "missing-evidence", "ledger-mismatch", "unsupported-coordinate"] },
          "scenario": { "type": "string", "minLength": 20, "maxLength": 500 },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verdict", "outcomes"],
            "properties": {
              "verdict": { "enum": ["accept", "refuse"] },
              "outcomes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
