{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youdede.dev/schemas/pack-evidence-v1.json",
  "title": "youdede pack evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "packId", "packVersion", "generatedAt", "ledgerEntryHash", "outcomes"],
  "properties": {
    "$schema": { "const": "https://youdede.dev/schemas/pack-evidence-v1.json" },
    "schemaVersion": { "const": 1 },
    "packId": { "type": "string", "pattern": "^pack/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "packVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "ledgerEntryHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome", "status", "evidence"],
        "properties": {
          "outcome": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "status": { "enum": ["verified", "unverified"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifactId", "evidenceHash", "claim"],
              "properties": {
                "artifactId": { "type": "string", "pattern": "^(skill|hook|subagent|command|context|mcp-server)/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$" },
                "evidenceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "claim": { "type": "string", "minLength": 10, "maxLength": 500 }
              }
            }
          }
        }
      }
    }
  }
}
